grammar CobolDependency extends CobolDependencyBase.

## #############################################################################
## Simple COBOL Dependency Grammar
## Focus: Extract only dependency-related constructs
## -----------------------------------------------------------------------------

# Main entry point - parse for dependencies
def dependencyAnalysis =
    (dependencyStatement | skipStatement)*
    [eof]
end

# Any statement that creates dependencies
def dependencyStatement =
    ( copyStatement
    | callStatement
    | programDefinition
    | functionDefinition
    )
end

# Skip any non-dependency statements
def skipStatement =
    ( anyStatement
    | anyParagraph
    | anySection
    | anyDivision
    | anyLine
    )
end

## #############################################################################
## COPY statements - main dependency source
## (Inherited from CobolPreprocessingGrammar)
## -----------------------------------------------------------------------------

## #############################################################################
## CALL statements - program dependencies
## -----------------------------------------------------------------------------

def callStatement =
    CALL
    
    ( [ programName AS ] NESTED                                   # Format 3
    |   programName AS   programPrototypeName                     # Format 3
    | # [MF - CALL statement] The mnenomic name specifies the calling convention.
      (mnemonicName: identifier) programName
    | programName                                                 # Format 1, 2
    )

    [ using  ]
    [ giving ]

    [ unknown: --> somethingFollowingAStatement ]

    [ onOverflow                                                  # Format 1
    | !(onException | notOnException)                             # Format 2, 3
    ]

    [`end : END-CALL]

  where def programName          =  ( alphanumericLiteral | identifier )  end
  where def programPrototypeName =  justAName                             end

  where def using =
      USING ( byReference | byContent | byValue | copyStatement )+

    where def byReference =  [[BY] REFERENCE] (modifier | arg)+  end
    where def byContent   =   [BY] CONTENT    (modifier | arg)+  end
    where def byValue     =   [BY] VALUE      (modifier | arg)+  end

    where def modifier =
        (
        # [GNU Cobol 2.0], CALL: preceding a literal or identifier.
          unsigned: UNSIGNED
        
        # [MF - CALL Statement]: following an integer.
        # [IBM ILE CALL Statement]: following a float or an integer.
        # [GNU Cobol 2.0], CALL: preceding a literal or identifier.
        | sizeIs
        )

      where def sizeIs =
          SIZE [IS]
          ( AUTO | DEFAULT                  # GNU Cobol
          | integer                         # GNU Cobol, IBM
          )
      end
    end

    where def arg =
        ( addressOf                       # [IBM Cobol zOS 4.2], CALL statement
        | lengthOf                        # [IBM Cobol zOS 4.2], CALL statement
        | omitted: OMITTED
        | identifier (%not moreArithmeticOp)
        | literal    (%not moreArithmeticOp)
        | arithmeticExpression
        )
    end
  end
  
  where def giving =
      ( GIVING | RETURNING ) 
      ( addressOf | [INTO] identifier )
  end
end

## #############################################################################
## Program definitions - what we're calling
## -----------------------------------------------------------------------------

def programDefinition =
    # In Micro Focus Cobol all parts are optional (cfr. [MF - Compilation 
    # Groups]), which means this grammar rule could match empty inputs.
    # Allowing that would just cause trouble, so we add an extra restriction
    # on this match to make sure we at least consumed something.
    %notempty (
        [ identificationDivision : %notempty (
            [header: (ID | IDENTIFICATION) DIVISION .]
            
            # Micro Focus makes the program-id-paragraph optional, which is
            # why we need the '%notempty' restriction above.
            # Cfr. [MF - Compilation Groups]
            [programIdParagraph]
            
            [replaceStatement]                       # SM208A.CBL
            [optionsParagraph]
            [metadata]                               # Found in the testsuite.
        )]
        
        [environmentDivision]
        [dataDivision]
        [procedureDivision (sourceUnit : programDefinition)*]
    )
    
    # The end marker shouldn't count towards the contents of the program
    # definition. If it would then it would get caught up in the recursive call
    # above as an empty program.
    [ END PROGRAM
      # Given that the program-id-paragraph may be optional in Micro Focus you
      # don't always have a program name to mention here. I have seen it being
      # omitted in actual code, though I can't find any documentation (not even
      # from Micro Focus) which states that it is indeed optional...
      [programName]
      .
    ]
end

def functionDefinition = functionDefinitionBody . end

private def functionDefinitionBody =
    ( identificationDivision :
        [header: (ID | IDENTIFICATION) DIVISION .]
        functionIdParagraph
        [optionsParagraph]
    ) 
    
    [environmentDivision]
    [dataDivision]
    [procedureDivision]
    END FUNCTION functionName .
end

## #############################################################################
## Identification paragraphs - program names
## -----------------------------------------------------------------------------

def programIdParagraph =
    PROGRAM-ID . programName [IS] [commonName] [AS] [commonName]
end

def functionIdParagraph =
    FUNCTION-ID [.] functionName [AS literal] [.]
end

## #############################################################################
## Divisions - simplified structure
## -----------------------------------------------------------------------------

def identificationDivision =
    (ID | IDENTIFICATION) DIVISION .
    ( programIdParagraph
    | functionIdParagraph
    | copyStatement
    )*
end

def environmentDivision =
    ENVIRONMENT DIVISION .
    ( configurationSection
    | inputOutputSection
    | copyStatement
    )*
end

def dataDivision =
    DATA DIVISION .
    ( fileSection
    | workingStorageSection
    | linkageSection
    | copyStatement
    )*
end

def procedureDivision =
    PROCEDURE DIVISION .
    [usingClause]
    [returningClause]
    ( statement | copyStatement )*
end

## #############################################################################
## Sections - minimal structure
## -----------------------------------------------------------------------------

def configurationSection =
    CONFIGURATION SECTION .
    ( specialNamesParagraph
    | copyStatement
    )*
end

def inputOutputSection =
    INPUT-OUTPUT SECTION .
    ( fileControlParagraph
    | copyStatement
    )*
end

def fileSection =
    FILE SECTION .
    ( fileDescriptionEntry
    | copyStatement
    )*
end

def workingStorageSection =
    WORKING-STORAGE SECTION .
    ( dataDescriptionEntry
    | copyStatement
    )*
end

def linkageSection =
    LINKAGE SECTION .
    ( dataDescriptionEntry
    | copyStatement
    )*
end

## #############################################################################
## Paragraphs and entries
## -----------------------------------------------------------------------------

def specialNamesParagraph =
    SPECIAL-NAMES .
    ( specialNameStatement
    | copyStatement
    )*
    [.]
end

def fileControlParagraph =
    FILE-CONTROL .
    ( selectStatement
    | copyStatement
    )+
end

def fileDescriptionEntry =
    FD fileName [fileDescriptionClause]* .
end

def dataDescriptionEntry =
    ( levelNumber | levelNumber77 )
    [ dataName | filler ]
    [ pictureClause ]
    [ valueClause ]
    [ copyStatement ]
end

## #############################################################################
## Basic elements
## -----------------------------------------------------------------------------

def programName =
    ( alphanumeric
    | justAName
    )
end

def alphanumeric =
    ( alphanumericLiteral
    | alphanumericConstant
    )
end

def alphanumericConstant =
    justAName
end

private def justAName =
    (%not hexadecimalLiteral)
    cobolWord
end

private def hexadecimalLiteral =
    ( hexadecimal
    | alphanumericHexadecimal
    | nationalAlphanumericHexadecimal
    | booleanHexadecimal
    )
end

def hexadecimal =
    'H' ++ str
end

def alphanumericHexadecimal =
    'X' ++ str
end

def nationalAlphanumericHexadecimal =
    'NX' ++ str
end

def booleanHexadecimal =
    'BX' ++ str
end

# Name definitions inherited from CobolPreprocessingGrammar
# (textName, libraryName are already defined)

# Additional name definitions needed for dependency analysis
# (functionName, commonName, dataName, fileName are NOT inherited)
def functionName =
    justAName
end

def commonName =
    justAName
end

def dataName =
    justAName
end

def fileName =
    ( alphanumeric
    | justAName
    )
end

private def moreArithmeticOp =
    ( B-AND | B-OR | B-XOR | B-EXOR
    | '+' | '-' | ('*' ++ '*') | '*' | '/'
    )
end

# Literal definitions inherited from CobolPreprocessingGrammar

## #############################################################################
## Additional elements
## -----------------------------------------------------------------------------

def levelNumber = 
    @NUMBER _
end

def levelNumber77 = 
    77
end

def filler = 
    FILLER
end

def pictureClause = 
    PICTURE [IS] pictureString
end

def valueClause = 
    VALUE [IS] literal
end

def modifier = 
    (OMITTED | cobolWord)
end

def arg = 
    (literal | dataName | cobolWord)
end

def usingClause = 
    USING (byReference | byContent | byValue)+
    
  where def byReference =  [[BY] REFERENCE] (modifier | arg)+  end
  where def byContent   =   [BY] CONTENT    (modifier | arg)+  end
  where def byValue     =   [BY] VALUE      (modifier | arg)+  end
end

def returningClause = 
    RETURNING dataName
end

def specialNameStatement = 
    cobolWord [IS] cobolWord
end

def selectStatement = 
    SELECT [OPTIONAL] fileName ASSIGN TO (assignmentName | literal)
end

def assignmentName = 
    cobolWord
end

def fileDescriptionClause = 
    cobolWord
end

def statement = 
    ( anyWord | anyLiteral | anySeparator | anyWhitespace )+
    ( [.] | [eol] )
end

## #############################################################################
## Skip statements - handle non-dependency constructs
## -----------------------------------------------------------------------------

# Skip any statement we don't care about
def anyStatement =
    ( anyWord
    | anyLiteral
    | anySeparator
    | anyWhitespace
    )+
    [.]
end

# Skip any paragraph we don't care about
def anyParagraph =
    ( anyWord
    | anyLiteral
    | anySeparator
    | anyWhitespace
    )+
    [.]
end

# Skip any section we don't care about
def anySection =
    ( anyWord
    | anyLiteral
    | anySeparator
    | anyWhitespace
    )+
    [.]
end

# Skip any division we don't care about
def anyDivision =
    ( anyWord
    | anyLiteral
    | anySeparator
    | anyWhitespace
    )+
    [.]
end

# Skip any line we don't care about
def anyLine =
    ( anyWord
    | anyLiteral
    | anySeparator
    | anyWhitespace
    )+
    [eol]
end

# Basic skip elements
def anyWord = 
    @WORD _
end

def anyLiteral = 
    (literal | str)
end

def anySeparator = 
    @SEPARATOR _
end

def anyWhitespace = 
    @WHITESPACE _
end

def eol = 
    @END_OF_LINE _
end

# Error recovery for malformed statements
def somethingFollowingAStatement =
    ( .
    | anyStatement
    | anyParagraph
    | anySection
    | anyDivision
    | anyLine
    )
end

# Additional definitions for comprehensive CALL statement
def identifier =
    ( qualifiedDataName
    | justAName
    )
end

def qualifiedDataName =
    dataName [qualifier] ['(' (subscript)+ ')']
end

def qualifier =
    ((IN | OF) dataName)+
end

def subscript =
    ( literal | dataName | cobolWord )
end

def mnemonicName =
    identifier
end

def addressOf =
    ADDRESS OF (identifier | literal)
end

def lengthOf =
    LENGTH OF (identifier | literal)
end

def arithmeticExpression =
    ( literal | dataName | cobolWord )
end

def integer =
    uintgr
end

def onOverflow =
    [ON] OVERFLOW ( statement )*
end

def onException =
    [ON] EXCEPTION ( statement )*
end

def notOnException =
    NOT [ON] EXCEPTION ( statement )*
end

# Additional identification division elements
def replaceStatement =
    REPLACE (replacing | off) .

  where def replacing = [also: ALSO] (replacementInstruction)+ end
  where def off       = [last: LAST] OFF                        end
end

def optionsParagraph =
    OPTIONS .
    ( optionStatement
    | copyStatement
    )*
    [.]
end

def optionStatement =
    ( anyWord | anyLiteral | anySeparator | anyWhitespace )+
end

def metadata =
    METADATA .
    ( metadataStatement
    | copyStatement
    )*
    [.]
end

def metadataStatement =
    ( anyWord | anyLiteral | anySeparator | anyWhitespace )+
end

# Simplified sourceUnit for dependency analysis
def sourceUnit =
    ( programDefinition
    | functionDefinition
    | statement
    | anyStatement
    | anyParagraph
    | anySection
    | anyDivision
    | anyLine
    )
end
